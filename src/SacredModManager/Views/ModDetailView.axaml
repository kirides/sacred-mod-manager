<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SacredModManager.ViewModels"
             xmlns:core="clr-namespace:SacredModManager.Core.Mods;assembly=SacredModManager.Core"
             x:Class="SacredModManager.Views.ModDetailView"
             x:DataType="vm:ModItemViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20,18,20,24" Spacing="14">
      <!-- picture -->
      <Border CornerRadius="10" ClipToBounds="True" Height="170" Background="{Binding PlaceholderBrush}">
        <Grid>
          <TextBlock Text="{Binding Initials}" FontSize="54" FontWeight="Bold" Foreground="#CCFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding !HasThumbnail}" />
          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
        </Grid>
      </Border>

      <!-- title -->
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Name}" Classes="h1" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding VersionText}" Classes="secondary" IsVisible="{Binding HasVersion}" />
          <TextBlock Text="by" Classes="secondary" IsVisible="{Binding HasAuthor}" />
          <TextBlock Text="{Binding Author}" Classes="secondary" IsVisible="{Binding HasAuthor}" />
        </StackPanel>
      </StackPanel>

      <WrapPanel>
        <Border Classes="chip ok" Margin="0,0,6,6" IsVisible="{Binding IsEnabled}"><TextBlock Text="On" /></Border>
        <Border Classes="chip" Margin="0,0,6,6"><TextBlock Text="{Binding StatusText}" /></Border>
        <Border Classes="chip info" Margin="0,0,6,6" IsVisible="{Binding UpdateAvailable}"><TextBlock Text="Update available" /></Border>
        <Border Classes="chip" Margin="0,0,6,6" IsVisible="{Binding IsManual}"><TextBlock Text="Installed by hand" /></Border>
      </WrapPanel>

      <!-- actions -->
      <WrapPanel>
        <Button Classes="primary" Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}" Margin="0,0,8,8">
          <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IconDownload}" /><TextBlock Text="Install" /></StackPanel>
        </Button>
        <Button Classes="primary" Command="{Binding InstallCommand}" IsVisible="{Binding CanUpdate}" Margin="0,0,8,8">
          <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IconUpgrade}" /><TextBlock Text="{Binding AvailableVersion, StringFormat='Update to {0}'}" /></StackPanel>
        </Button>
        <Button Command="{Binding OpenFolderCommand}" IsVisible="{Binding IsInstalled}" Margin="0,0,8,8" ToolTip.Tip="Show the mod's folder in Explorer">
          <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IconFolder}" /><TextBlock Text="Open folder" /></StackPanel>
        </Button>
        <Button Command="{Binding RestoreCommand}" IsVisible="{Binding HasBackup}" Margin="0,0,8,8" ToolTip.Tip="Put back the copy that was saved before the last update or removal">
          <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IconHistory}" /><TextBlock Text="Restore previous" /></StackPanel>
        </Button>
        <Button Classes="danger" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}" Margin="0,0,8,8">
          <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource IconDelete}" /><TextBlock Text="Remove" /></StackPanel>
        </Button>
      </WrapPanel>

      <Border Classes="card" Padding="12,8" IsVisible="{Binding IsInstalled}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Text="Switched on in the game" FontWeight="SemiBold" />
            <TextBlock Text="Saved in mods\gear_mods.json, where Sacred Gear reads it. Takes effect when the game starts." Classes="hint" TextWrapping="Wrap" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=OneWay}" Command="{Binding ToggleCommand}" OnContent="" OffContent="" IsEnabled="{Binding !HasError}"
                        AutomationProperties.Name="Switch the mod on or off" />
        </Grid>
      </Border>

      <!-- problems -->
      <Border Classes="banner err" IsVisible="{Binding HasError}">
        <StackPanel Spacing="2">
          <TextBlock Text="This mod cannot be loaded" FontWeight="SemiBold" Classes="err" />
          <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Classes="banner warn" IsVisible="{Binding HasMissingRequirements}">
        <TextBlock Text="{Binding MissingText}" TextWrapping="Wrap" />
      </Border>
      <Border Classes="banner warn" IsVisible="{Binding HasModifiedFiles}">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding ModifiedText}" TextWrapping="Wrap" FontWeight="SemiBold" />
          <TextBlock Text="An update replaces them; the copy you have now is kept in the backup." Classes="hint" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />

      <StackPanel Spacing="6" IsVisible="{Binding HasRequirements}">
        <TextBlock Text="Needs" Classes="h2" />
        <ItemsControl ItemsSource="{Binding Requirements}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RequirementViewModel">
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                <PathIcon Data="{StaticResource IconCheck}" Foreground="{DynamicResource AppOkBrush}" IsVisible="{Binding Met}" />
                <PathIcon Data="{StaticResource IconWarning}" Foreground="{DynamicResource AppWarnBrush}" IsVisible="{Binding !Met}" />
                <TextBlock Text="{Binding Name}" />
                <TextBlock Text="{Binding State}" Classes="hint" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Spacing="2" IsVisible="{Binding HasSource}">
        <TextBlock Text="Source" Classes="h2" />
        <TextBlock Text="{Binding SourceName}" Classes="secondary" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Spacing="2" IsVisible="{Binding HasTags}">
        <TextBlock Text="Categories" Classes="h2" />
        <TextBlock Text="{Binding TagsText}" Classes="secondary" TextWrapping="Wrap" />
      </StackPanel>

      <Expander IsVisible="{Binding HasSettings}" Header="Settings in the game" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="4">
          <TextBlock Text="Change them in the game with F11. Defaults:" Classes="hint" />
          <ItemsControl ItemsSource="{Binding Settings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="core:SettingDecl">
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                  <TextBlock Text="{Binding Label}" TextWrapping="Wrap" ToolTip.Tip="{Binding Tooltip}" />
                  <TextBlock Grid.Column="1" Text="{Binding DefaultText}" Classes="hint" Margin="12,0,0,0" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Expander>

      <Expander IsVisible="{Binding HasKeys}" Header="Key binds" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <ItemsControl ItemsSource="{Binding Keys}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="core:KeyDecl">
              <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                <Border Grid.Column="1" Classes="chip tag" Margin="12,0,0,0"><TextBlock Text="{Binding Default}" /></Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
