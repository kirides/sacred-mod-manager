<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:SacredModManager.Features.Dialogs"
             xmlns:common="clr-namespace:SacredModManager.Features.Common"
             x:Class="SacredModManager.Features.Dialogs.DialogView"
             x:DataType="dialogs:DialogViewModel">
    <Grid IsVisible="{Binding IsOpen}" Background="{DynamicResource AppScrimBrush}">
      <Border Classes="overlay" Width="{Binding DialogWidth}" MaxHeight="700" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
        <StackPanel Spacing="14">
          <TextBlock Text="{Binding Title}" Classes="h1" TextWrapping="Wrap" FontSize="19" />
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding HasMessage}" />
          <Border Classes="card" Padding="12,8" IsVisible="{Binding HasMarkdown}" MaxHeight="480">
            <ScrollViewer>
              <SelectableTextBlock common:MarkdownText.Source="{Binding Markdown}" TextWrapping="Wrap" />
            </ScrollViewer>
          </Border>
          <Border Classes="card" Padding="10,6" IsVisible="{Binding HasLines}" MaxHeight="210">
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Lines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" Margin="0,2" TextWrapping="Wrap" /></DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
          <Border Classes="card" Padding="6" IsVisible="{Binding HasEntries}" MaxHeight="340">
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="dialogs:DialogEntry">
                    <StackPanel Margin="0,4" Spacing="2">
                      <Grid ColumnDefinitions="*,Auto" Margin="8,2,8,0">
                        <StackPanel Spacing="1">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Note}" Classes="hint" TextWrapping="Wrap" IsVisible="{Binding HasNote}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="12,0,0,0">
                          <TextBlock Text="{Binding Versions}" VerticalAlignment="Center" />
                          <Border Classes="chip tag"><TextBlock Text="{Binding Badge}" /></Border>
                        </StackPanel>
                      </Grid>
                      <Expander Header="What's new" FontSize="12" MinHeight="0" IsExpanded="True" IsVisible="{Binding HasChanges}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,4">
                        <SelectableTextBlock common:MarkdownText.Source="{Binding Changes}" TextWrapping="Wrap" FontSize="12" />
                      </Expander>
                      <Expander Header="Details" FontSize="12" MinHeight="0" IsVisible="{Binding HasDetails}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,4">
                        <SelectableTextBlock Text="{Binding DetailsText}" Classes="hint" TextWrapping="Wrap" />
                      </Expander>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
          <CheckBox IsChecked="{Binding CheckValue}" Content="{Binding CheckText}" IsVisible="{Binding HasCheck}" />
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Name="DialogSecondary" Content="{Binding SecondaryText}" IsVisible="{Binding HasSecondary}" Click="OnDialogSecondary" />
            <Button Name="DialogPrimaryAccent" Classes="primary" Content="{Binding PrimaryText}" IsVisible="{Binding PrimaryIsAccent}" Click="OnDialogPrimary" />
            <Button Name="DialogPrimaryDanger" Classes="danger" Content="{Binding PrimaryText}" IsVisible="{Binding Destructive}" Click="OnDialogPrimary" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
</UserControl>
