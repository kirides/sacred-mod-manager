<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:SacredModManager.Features.Settings"
             x:Class="SacredModManager.Features.Settings.SettingsPageView"
             x:DataType="settings:SettingsPageViewModel">
  <Grid RowDefinitions="Auto,*">
    <Border Classes="toolbar">
      <TextBlock Text="Settings" Classes="h1" />
    </Border>
    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="20,16,20,24" Spacing="18" MaxWidth="760" HorizontalAlignment="Left">
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="Sacred Gold folder" Classes="h2" />
            <TextBlock Text="The folder with Sacred.exe. Mods are installed into its mods folder; nothing else in the game folder is touched." Classes="secondary" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding FolderText}" AutomationProperties.Name="Game folder" />
              <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseCommand}" />
              <Button Grid.Column="2" Classes="primary" Content="Use this folder" Command="{Binding ApplyCommand}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource IconCheck}" Foreground="{DynamicResource AppOkBrush}" IsVisible="{Binding FolderOk}" />
              <PathIcon Data="{StaticResource IconWarning}" Foreground="{DynamicResource AppWarnBrush}" IsVisible="{Binding !FolderOk}" />
              <TextBlock Text="{Binding FolderMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
            <Button Classes="link" Content="Look for Sacred Gold automatically" Command="{Binding DetectCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="Tools folder" Classes="h2" />
            <TextBlock Text="Tools (programs from the sources, for example the class editor) are unpacked here, one folder each. Plugins go into the Sacred folder, mods into its mods folder." Classes="secondary" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding ToolsFolderText}" AutomationProperties.Name="Tools folder" />
              <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseToolsCommand}" />
              <Button Grid.Column="2" Content="Use this folder" Command="{Binding ApplyToolsCommand}" />
            </Grid>
            <Button Classes="link" Content="Use the manager's own folder" Command="{Binding ResetToolsCommand}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Text="Look and behaviour" Classes="h2" />
            <StackPanel Spacing="4">
              <TextBlock Text="Theme" />
              <ComboBox ItemsSource="{Binding Themes}" SelectedIndex="{Binding ThemeIndex}" MinWidth="220" AutomationProperties.Name="Theme" />
            </StackPanel>
            <CheckBox IsChecked="{Binding AskBeforeRemove}" Content="Ask before removing a mod (a backup is always kept)" />
            <CheckBox IsChecked="{Binding CheckForUpdates}" Content="Tell me when a new version of the manager is available (nothing is downloaded)" />
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding LinksSupported}">
          <StackPanel Spacing="10">
            <TextBlock Text="Links" Classes="h2" />
            <TextBlock Text="With links on, a click on a gear-mod-manager:// link in a browser adds a source or installs a mod here. The manager always asks first and says where the mod comes from. Registered for your user only; no administrator rights." Classes="secondary" TextWrapping="Wrap" />
            <CheckBox IsChecked="{Binding RegisterLinks}" Content="Open gear-mod-manager:// links with this program" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <PathIcon Data="{StaticResource IconCheck}" Foreground="{DynamicResource AppOkBrush}" IsVisible="{Binding LinkOk}" />
              <PathIcon Data="{StaticResource IconWarning}" Foreground="{DynamicResource AppWarnBrush}" IsVisible="{Binding !LinkOk}" />
              <TextBlock Text="{Binding LinkStatus}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
            <Button Content="Use this copy for links" Command="{Binding UseThisCopyForLinksCommand}" IsVisible="{Binding CanTakeOverLinks}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="Where the manager keeps its files" Classes="h2" />
            <TextBlock Text="Settings" Classes="hint" />
            <TextBlock Text="{Binding SettingsFile}" TextWrapping="Wrap" />
            <TextBlock Text="Downloads, pictures and backups of removed or replaced mods" Classes="hint" />
            <TextBlock Text="{Binding DataFolder}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
              <Button Content="Open the folder" Command="{Binding OpenDataFolderCommand}" />
              <Button Content="Delete downloads and pictures" Command="{Binding ClearCacheCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Text="About" Classes="h2" />
            <TextBlock Text="{Binding Version}" />
            <TextBlock Text="A manager for Sacred Gear mods. Mod information is read from each mod's mod.lua in a locked-down Lua sandbox (no files, no operating system, limited time and memory); mod code is never run." Classes="secondary" TextWrapping="Wrap" />
            <TextBlock Text="Shortcuts: Ctrl+1 to Ctrl+4 pages, Ctrl+F search, F5 refresh, Ctrl+Z undo, Ctrl+O install from a mod archive (zip, tar, tar.gz, tar.zst)." Classes="hint" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
